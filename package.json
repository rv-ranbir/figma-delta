{
  "name": "figma-delta",
  "version": "0.2.2",
  "description": "Figma design comparison for QA, developers and AI agents",
  "type": "module",
  "main": "./src/api.js",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "bin": {
    "figma-delta": "src/cli.js",
    "figma-fidelity": "src/cli.js"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "doctor": "node scripts/doctor.js",
    "release:zip": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "sample": "node examples/serve-sample.js",
    "sample:prepare": "node examples/prepare-sample.js",
    "sample:check": "node examples/check-sample.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "demo": "node examples/demo.js",
    "showcase": "node examples/showcase.js",
    "mcp": "node src/mcp.js",
    "test:unit": "node --test test/core.test.js test/mcp.test.js test/paths.test.js",
    "test:package": "node scripts/verify-package.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "culori": "4.0.2",
    "pixelmatch": "7.2.0",
    "playwright": "1.64.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rv-ranbir/figma-delta.git"
  },
  "homepage": "https://github.com/rv-ranbir/figma-delta#readme",
  "bugs": {
    "url": "https://github.com/rv-ranbir/figma-delta/issues"
  },
  "license": "MIT",
  "author": "rv-ranbir",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "src",
    "templates",
    "scripts/setup.js",
    "scripts/doctor.js",
    "docs/findings-format.md",
    "docs/distribution.md",
    "SECURITY.md",
    "LICENSE",
    "docs/configuration.md",
    "docs/per-run-comparisons.md",
    "docs/prepared-pages.md",
    "docs/sample-prompts.md",
    "docs/showcase.md",
    "docs/images",
    "docs/figma-reference.md",
    "CONTRIBUTING.md",
    "VALIDATION.md"
  ]
}
